horizontal_scroll_mode = 0

[node name="Moves" type="VBoxContainer" parent="Margin/Layout/MovesScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
script = ExtResource("3_moves")

